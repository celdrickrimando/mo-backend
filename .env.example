# Copy this to .env for local development only (never commit a real .env —
# it's already in .gitignore). On Render, set these under the service's
# Environment tab instead of using a file.

# Service-account credentials for reading the Mo Rules Google Sheet.
# See ../CANONICAL_SHEET_SETUP.md for how to obtain these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
MO_RULES_SHEET_ID=

# Optional — if set, POST /refresh-rules requires this value in an
# "x-refresh-secret" header. Leave blank to leave the endpoint open (it
# only clears a cache, never writes anything, so this is optional
# hardening rather than a strict requirement).
REFRESH_RULES_SECRET=

# --- Access control (server/src/auth.js) ---
# Only Google accounts in this domain, or explicitly listed below, are
# allowed to use Mo. Every request is verified against Google's tokeninfo
# endpoint server-side — this can't be bypassed by editing the extension's
# own source, since the check never trusts the client.
# Default (if left blank) is @dlsu.edu.ph only. ALLOWED_EMAILS is for named
# exceptions (e.g. a non-DLSU tester); leave blank for a pure Workspace rollout.
ALLOWED_EMAIL_DOMAIN=dlsu.edu.ph
ALLOWED_EMAILS=

# Must match WEB_CLIENT_ID at the top of extension/popup.js — used to reject
# access tokens that were issued to some other OAuth app. Defaults (if
# blank) to the client ID already built into auth.js.
GOOGLE_OAUTH_CLIENT_ID=269390370504-gmdl1a28ghlcg385r93cd8caallg4m7f.apps.googleusercontent.com

# Optional — pin the API to specific extension IDs (comma-separated), e.g. the
# Chrome Web Store item ID. Blank = any chrome-extension:// origin.
ALLOWED_EXTENSION_IDS=

# Set to "production" on the host. Makes /refresh-rules require REFRESH_RULES_SECRET.
NODE_ENV=production

# Optional — comma-separated list of extra web origins (besides
# chrome-extension://<id>, which is always allowed) permitted to call this
# API from a browser. Leave blank in production.
ALLOWED_ORIGINS=
